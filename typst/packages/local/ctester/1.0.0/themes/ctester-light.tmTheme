<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- THE C HIGHLIGHTING OF TYPST STATEMENTS, AND IT IS THE SAME AS THE EDITOR'S.
     The seven rules below are exactly the seven classes of
     `frontend/src/lib/domain/highlight.ts` (tc ts tp tk tn tf tu), with the
     colours of `frontend/src/app.css`. Two highlightings of one language must
     say the same thing, or the student reads an `int` that is blue in the
     editor and green in the statement.

     GENERATED, THEN COMMITTED: `test_the_typst_theme_carries_the_page_colors`
     rereads `app.css` and this file and refuses any divergence. Editing one
     without the other fails the suite.

     MEASURED TRAP: a `.tmTheme` only colours SCOPED tokens. Bare identifiers
     (`s`, `main`, `n`) take the `fill` of the surrounding Typst `text`, NOT
     the `foreground` below -- without a `#set text(fill: ...)` next to it,
     they come out black, invisible on a dark background. The `show raw` rule
     in `lib.typ` sets it. -->
<plist version="1.0"><dict>
  <key>name</key><string>ctester-light</string>
  <key>settings</key><array>
    <dict><key>settings</key><dict>
      <key>background</key><string>#F5F5F8</string>
      <key>foreground</key><string>#1D1F20</string>
    </dict></dict>
    <dict><key>scope</key><string>comment</string>
      <key>settings</key><dict><key>foreground</key><string>#5F6B60</string><key>fontStyle</key><string>italic</string></dict></dict>
    <dict><key>scope</key><string>string, constant.character.escape</string>
      <key>settings</key><dict><key>foreground</key><string>#1F7A3D</string></dict></dict>
    <dict><key>scope</key><string>meta.preprocessor, keyword.control.import, keyword.control.directive</string>
      <key>settings</key><dict><key>foreground</key><string>#9B2F8F</string></dict></dict>
    <dict><key>scope</key><string>keyword, storage.type, storage.modifier, keyword.control</string>
      <key>settings</key><dict><key>foreground</key><string>#1D4ED8</string><key>fontStyle</key><string>bold</string></dict></dict>
    <dict><key>scope</key><string>constant.numeric</string>
      <key>settings</key><dict><key>foreground</key><string>#A55200</string></dict></dict>
    <dict><key>scope</key><string>variable.function, entity.name.function, support.function</string>
      <key>settings</key><dict><key>foreground</key><string>#7A5C00</string></dict></dict>
    <dict><key>scope</key><string>entity.name.constant, variable.other.constant, constant.other, constant.language</string>
      <key>settings</key><dict><key>foreground</key><string>#8A3D9B</string></dict></dict>
  </array>
</dict></plist>
