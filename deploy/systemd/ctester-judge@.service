[Unit]
Description=CTester judge %i
After=docker.service
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/opt/ctester/.env
ExecStart=/opt/ctester/bin/ctester-judge run
Restart=always
RestartSec=2
StateDirectory=ctester-judge
ProtectSystem=strict
ReadWritePaths=/opt/ctester/spool /opt/ctester/results
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
# No RestrictSUIDSGID: systemd cannot inspect openat2's flags, so it blocks the whole call with
# ENOSYS, and the judge refuses to start without openat2.

[Install]
WantedBy=multi-user.target
