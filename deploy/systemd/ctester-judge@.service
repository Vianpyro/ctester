[Unit]
Description=CTester judge %i
After=docker.service
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/opt/ctester/.env
# After the EnvironmentFile: the .env is shared by every instance, so a CTESTER_WORKER_ID set
# there would name them all alike. %i is the instance number.
Environment=CTESTER_WORKER_ID=%i
ExecStart=/opt/ctester/bin/ctester-judge run
# on-failure: an on-demand instance leaving idle (exit 0) stays down. 75 is a judge
# restarting on a newly installed binary between two jobs.
Restart=on-failure
RestartSec=2
SuccessExitStatus=75
RestartForceExitStatus=75
StateDirectory=ctester-judge
ProtectSystem=strict
ReadWritePaths=/opt/ctester/spool /opt/ctester/results
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
# No RestrictSUIDSGID: systemd cannot inspect openat2's flags, so it blocks the whole call with
# ENOSYS, and the judge refuses to start without openat2.

[Install]
WantedBy=multi-user.target
