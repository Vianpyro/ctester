[Unit]
Description=CTester judge %i
After=docker.service
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/opt/ctester/.env
ExecStart=/opt/ctester/bin/ctester-judge run
Restart=always
RestartSec=2
StateDirectory=ctester-judge
ProtectSystem=strict
ReadWritePaths=/opt/ctester/spool
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
