COMPOSE_FILE=/opt/ctester/src/deploy/compose.yml
COMPOSE_PROFILES=

CTESTER_KEY=
CTESTER_ORIGINS=https://example.org
CTESTER_WORKERS=2
CTESTER_NETWORK=ctester-ingress
# The admin dashboard publishes no port: the proxy reaches it over CTESTER_NETWORK,
# and the access list on that proxy host is the only thing keeping it off the internet.
CTESTER_ADMIN_CPUS=0.25
CTESTER_ADMIN_MEMORY=256m
TZ=UTC

# One content root, or several joined by ":". Exercise ids stay unique across them
# and one branch and one deploy key serve them all.
CTESTER_CONTENT=/opt/ctester/content
CTESTER_CONTENT_BRANCH=main
CTESTER_CONTENT_SSH_KEY=
# CTESTER_API_ORIGIN is read here AND baked into the page at build time: the CSP in
# index.html names the same origin. Leave it empty when the page is served from the API's
# own origin. The three build-only settings below live as variables of the github-pages
# environment, where the `pages` job reads them; CTESTER_TITLE is what the page calls
# itself (default: CTester) and CTESTER_PAGES_DOMAIN writes the GitHub Pages CNAME.
CTESTER_API_ORIGIN=
CTESTER_AUTH_ORIGIN=
CTESTER_TITLE=
CTESTER_PAGES_DOMAIN=

CTESTER_BRANCH=main
CTESTER_REPO=Vianpyro/ctester
GH_TOKEN=

POSTGRES_PASSWORD=
CTESTER_DB_DSN=
CTESTER_OIDC_ISSUER=
CTESTER_OIDC_CLIENT_ID=
CTESTER_FORUM_MODERATORS=
CTESTER_SCRATCH=

CTESTER_DISCORD_URL=
CTESTER_DISCORD_WEBHOOK=
CTESTER_DISCORD_TOKEN=
CTESTER_DISCORD_BRIDGE_KEY=
CTESTER_DISCORD_CHANNELS=
