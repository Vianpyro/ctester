COMPOSE_FILE=/opt/ctester/src/deploy/compose.yml
COMPOSE_PROFILES=

CTESTER_KEY=
CTESTER_ORIGINS=https://example.org
CTESTER_WORKERS=2
CTESTER_NETWORK=ctester-ingress
# The admin dashboard publishes no port: the proxy reaches it over CTESTER_NETWORK,
# and the access list on that proxy host is the only thing keeping it off the internet.
CTESTER_ADMIN_CPUS=0.25
CTESTER_ADMIN_MEMORY=256m
TZ=UTC
# Every service logs JSON lines (docs/operations.md, "Logs"). debug adds successful requests.
CTESTER_LOG_LEVEL=info
CTESTER_LOG_SLOW_MS=1000
# Open tabs show an update notice while /opt/ctester/status/maintenance exists and is younger
# than this many seconds (docs/operations.md, "Warning students of an update").
CTESTER_MAINTENANCE_MAX=1800

# One content root, or several joined by ":". Exercise ids stay unique across them
# and one branch and one deploy key serve them all.
CTESTER_CONTENT=/opt/ctester/content
CTESTER_CONTENT_BRANCH=main
CTESTER_CONTENT_SSH_KEY=
# The page's settings are also variables of the github-pages environment, baked in at build
# time (see docs/operations.md). CTESTER_API_ORIGIN is read here too, and stays empty when the
# API serves the page itself. CTESTER_TITLE is the instance's name alone, e.g. TCH009.
# CTESTER_LANG (default en) is also read here by the content service for Typst statements.
CTESTER_API_ORIGIN=
CTESTER_AUTH_ORIGIN=
CTESTER_TITLE=
CTESTER_LANG=
CTESTER_PAGES_DOMAIN=

CTESTER_BRANCH=main
CTESTER_REPO=Vianpyro/ctester
GH_TOKEN=

POSTGRES_PASSWORD=
CTESTER_DB_DSN=
CTESTER_OIDC_ISSUER=
CTESTER_OIDC_CLIENT_ID=
CTESTER_FORUM_MODERATORS=
CTESTER_SCRATCH=

CTESTER_DISCORD_URL=
CTESTER_DISCORD_WEBHOOK=
CTESTER_DISCORD_TOKEN=
CTESTER_DISCORD_BRIDGE_KEY=
CTESTER_DISCORD_CHANNELS=
