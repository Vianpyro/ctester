{# ctester -- le tier web. Fichier géré par Ansible : éditer le rôle. #}
{# Aucun secret ici (la clé est dans ctester.env, 0600) -> 0644.        #}
{#                                                                      #}
{# LE NOM DU PROJET EST ÉPINGLÉ pour que le conteneur s'appelle          #}
{# `ctester-web-1` quoi qu'il arrive au nom du répertoire. C'est ce nom  #}
{# que NPM proxifie, et le proxy host vit dans la base SQLite de NPM,    #}
{# que ce dépôt ne voit pas : le renommer 502 le site jusqu'à ce que     #}
{# quelqu'un le corrige à la main, au pire moment.                       #}
name: ctester

services:
  web:
    image: {{ ctester_web_image }}
    pull_policy: always
    restart: unless-stopped

    # L'API n'utilise que la bibliothèque standard : rien à installer, donc
    # l'image officielle est lancée telle quelle sur un fichier monté.
    command: ["python3", "/app/app.py"]

    # Le fichier de clé, en 0600 sur l'hôte. `env_file` passe les valeurs
    # telles quelles au conteneur -- pas d'interpolation Compose, donc pas de
    # doublage de `$` à prévoir comme dans le rôle collabst.
    env_file:
      - ctester.env

    environment:
      TZ: {{ common_timezone }}
      CTESTER_SPOOL: /spool
      CTESTER_STATIC: /app

    volumes:
      # L'application en LECTURE SEULE : le processus exposé à Internet ne peut
      # pas réécrire son propre code.
      - ./app:/app:ro
      # La file. Le seul endroit inscriptible, et le seul canal entre ce
      # conteneur et le worker de l'hôte.
      - ./spool:/spool

    # PAS de /var/run/docker.sock, et c'est le point le plus important de ce
    # fichier. Le socket Docker est root-équivalent sur l'hôte ; le monter ici
    # ferait de n'importe quelle RCE dans app.py un root sur la machine qui sert
    # le DNS, le DHCP et le VPN. Le worker de l'hôte existe pour ça.
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    user: "65534:65534"
    tmpfs:
      - /tmp:size=8m

    # `expose`, pas `ports` : rien n'est publié sur l'hôte. Le seul à devoir
    # atteindre ce conteneur est NPM, et NPM est sur le réseau ci-dessous.
    expose:
      - "8000"

    networks:
      - {{ ingress_network }}

    # Sans requests ni curl dans l'image : urllib fait le travail.
    healthcheck:
      test: ["CMD", "python3", "-c",
             "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz')"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

    deploy:
      resources:
        limits:
          cpus: '{{ ctester_web_cpu_limit }}'
          memory: {{ ctester_web_mem_limit }}

networks:
  # `external` : ce stack échoue tout seul si le réseau du proxy manque, plutôt
  # que le proxy échoue parce que ce stack a disparu.
  {{ ingress_network }}:
    external: true
