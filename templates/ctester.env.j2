{# ctester -- configuration du tier web. Fichier géré par Ansible.        #}
{# Mode 0600 : il contient la clé de session distribuée sur Moodle.       #}
{#                                                                        #}
{# PAS DE DOUBLAGE DE `$` ici, contrairement au rôle collabst : ce fichier #}
{# est lu par `env_file`, dont Compose passe les valeurs littéralement, et #}
{# non par une interpolation `${...}` dans le compose.yml.                 #}
CTESTER_KEY={{ ctester_session_key }}
CTESTER_COOLDOWN={{ ctester_cooldown_seconds }}
CTESTER_HOURLY_QUOTA={{ ctester_hourly_quota }}
CTESTER_QUEUE_MAX={{ ctester_queue_max }}
CTESTER_MAX_CODE_BYTES={{ ctester_max_code_bytes }}
