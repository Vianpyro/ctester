{# Worker du bac à sable, instance %i. Fichier géré par Ansible.          #}
{#                                                                        #}
{# UNITÉ TEMPLATÉE, {{ ctester_workers }} instances activées : c'est le    #}
{# parallélisme du juge, et donc le nombre de cœurs qu'il peut prendre au  #}
{# Dell (chaque conteneur est plafonné à {{ ctester_sandbox_cpus }} CPU).  #}
{# Les workers se partagent la file par mkdir atomique sur .lock, donc en  #}
{# ajouter ou en retirer ne demande rien d'autre que d'activer l'instance. #}
[Unit]
Description=ctester -- worker du bac à sable (%i)
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 {{ ctester_project_dir }}/runner.py
Environment=CTESTER_SPOOL={{ ctester_project_dir }}/spool
Environment=CTESTER_TESTS={{ ctester_project_dir }}/tests
Environment=CTESTER_APP={{ ctester_project_dir }}/app
Environment=CTESTER_BUILD_UNITY={{ ctester_project_dir }}/build-unity.sh
Environment=CTESTER_BUILD_IO={{ ctester_project_dir }}/build-io.sh
Environment=CTESTER_IMAGE={{ ctester_sandbox_image }}
Environment=CTESTER_RUNTIME={{ ctester_runtime }}
Environment=CTESTER_JOB_TIMEOUT={{ ctester_job_timeout }}
Environment=CTESTER_MEMORY={{ ctester_sandbox_memory }}
Environment=CTESTER_PIDS={{ ctester_sandbox_pids }}
Environment=CTESTER_CPUS={{ ctester_sandbox_cpus }}
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=2

# Ce processus est root parce qu'il pilote Docker -- alors il n'a accès à rien
# d'autre. Il écrit dans deux répertoires et deux seulement : la file, et le
# catalogue public qu'il régénère au démarrage. Les tests, eux, sont lus en
# lecture seule ici et montés en lecture seule dans le conteneur.
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths={{ ctester_project_dir }}/spool {{ ctester_project_dir }}/app

[Install]
WantedBy=multi-user.target
